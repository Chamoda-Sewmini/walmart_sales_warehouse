      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CALCULATE;

/* =========================================================
   1. TOTAL MARKDOWN SPEND
   ========================================================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Total MarkDown Spend] AS
    CoalesceEmpty([Measures].[Mark Down1], 0)
    + CoalesceEmpty([Measures].[Mark Down2], 0)
    + CoalesceEmpty([Measures].[Mark Down3], 0)
    + CoalesceEmpty([Measures].[Mark Down4], 0)
    + CoalesceEmpty([Measures].[Mark Down5], 0),
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;


/* =========================================================
   2. AVERAGE WEEKLY SALES
   ========================================================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Average Weekly Sales] AS
    IIF(
        [Measures].[Fact Sales Count] = 0,
        NULL,
        [Measures].[Weekly Sales] / [Measures].[Fact Sales Count]
    ),
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;


/* =========================================================
   3. HOLIDAY WEEK AVERAGE SALES
   ========================================================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Holiday Week Avg Sales] AS
    (
        [Measures].[Average Weekly Sales],
        [Holiday Week Flag].[Is Holiday Week].&amp;[1]
    ),
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;


/* =========================================================
   4. NON-HOLIDAY WEEK AVERAGE SALES
   ========================================================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Non-Holiday Week Avg Sales] AS
    (
        [Measures].[Average Weekly Sales],
        [Holiday Week Flag].[Is Holiday Week].&amp;[0]
    ),
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;


/* =========================================================
   5. HOLIDAY LIFT
   ========================================================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Holiday Lift] AS
    [Measures].[Holiday Week Avg Sales]
    - [Measures].[Non-Holiday Week Avg Sales],
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;


/* =========================================================
   6. PREVIOUS YEAR WEEKLY SALES
   ========================================================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Weekly Sales PY] AS
    (
        ParallelPeriod(
            [Date].[Calendar].[Year],
            1,
            [Date].[Calendar].CurrentMember
        ),
        [Measures].[Weekly Sales]
    ),
    FORMAT_STRING = "#,##0.00",
    VISIBLE = 1;


/* =========================================================
   7. YEAR-OVER-YEAR SALES GROWTH
   ========================================================= */

CREATE MEMBER CURRENTCUBE.[Measures].[Sales YoY Growth %] AS
    IIF(
        IsEmpty([Measures].[Weekly Sales PY])
        OR [Measures].[Weekly Sales PY] = 0,
        NULL,
        (
            [Measures].[Weekly Sales]
            - [Measures].[Weekly Sales PY]
        )
        / [Measures].[Weekly Sales PY]
    ),
    FORMAT_STRING = "0.0%",
    VISIBLE = 1;</Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
  </Cubes>
